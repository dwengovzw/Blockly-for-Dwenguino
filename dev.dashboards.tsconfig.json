{
  "compilerOptions": {
    "pretty": true,

    "outDir": "./Blockly-for-Dwenguino/dashboards/js/dist",
    "noEmitOnError": true,
    "sourceMap": true,

    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2022"],
    "isolatedModules": false,
    "rootDir": ".",

    "strict": true,
    "noImplicitAny": false,

    "allowJs": true,
    "allowSyntheticDefaultImports": true,

    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "emitDecoratorMetadata": true,

    "skipLibCheck": true,
    "types": ["jquery"]
  },

  "include": [
    "./Blockly-for-Dwenguino/dashboards/js/src/**/*",
    "./shared/**/*",
    "./Blockly-for-Dwenguino/dashboards/generated/**/*",
    "./shared/types/**/*"
  ],

  "exclude": [
    "./backend",
    "./node_modules"
  ]
}
