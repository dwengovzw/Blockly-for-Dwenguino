{
    "testMatch": [
      "<rootDir>/specs/**/*.test.js"
    ],
    "transform": {},
    "verbose": true,
    "globalSetup": "../../util/puppeteer_setup.js",
    "globalTeardown": "../../util/puppeteer_teardown.js",
    "testEnvironment": "../../util/puppeteer_environment.js",
    "maxWorkers": 1,          
    "resetModules": true,     
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "preset": "jest-puppeteer"
  }