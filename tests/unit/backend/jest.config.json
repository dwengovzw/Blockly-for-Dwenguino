{
  "testEnvironment": "node",
  "moduleNameMapper": {
    "@exmpl/(.*)": "<rootDir>/src/$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": ["babel-jest", {
      "presets": [
        ["@babel/preset-env", { "targets": { "node": "current" } }],
        ["@babel/preset-typescript", { "allowDeclareFields": true }]
      ]
    }]
  },
  "extensionsToTreatAsEsm": [".ts"],
  "moduleFileExtensions": ["ts", "js", "json"],
  "verbose": true,
  "preset": "ts-jest/presets/default-esm",
  "testMatch": [
    "<rootDir>/**/*.test.ts"
  ]
}